# ==========================================
# MUBATO CMS Companion
# Archivos que NO deben entrar en Git
# ==========================================

# Variables de entorno / secretos
.env
.env.*
!.env.example

# Dependencias instaladas
node_modules/

# Archivos del sistema macOS
.DS_Store
.AppleDouble
.LSOverride

# Directorios temporales
tmp/
temp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos generados por Electron / desarrollo
dist/
build/
out/

# Archivos temporales de VS Code
.vscode/*.log
Proyectos/
